{
  "openapi": "3.0.0",
  "info": {
    "title": "Gemini Content Generator API",
    "description": "A custom pure-Gemini API that uses MCP tools.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://gemini-enterprise-mcp-app-1018377306275.us-central1.run.app"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "summary": "Generate Content",
        "operationId": "generate_content_chat_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "title": "ChatRequest",
        "required": [
          "prompt"
        ],
        "type": "object",
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string"
          }
        }
      },
      "ChatResponse": {
        "title": "ChatResponse",
        "required": [
          "response"
        ],
        "type": "object",
        "properties": {
          "response": {
            "title": "Response",
            "type": "string"
          },
          "used_tools": {
            "title": "Used Tools",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}